{
  "permissions": {
    "allow": [],
    "deny": [
      "Edit(~/.claude/hooks/ssh-guard.js)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline-command.js",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "superpowers@ai-brain": true,
    "frontend-design@claude-plugins-official": true,
    "codex@openai-codex": true,
    "ai-brain@ai-brain": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": { "source": "github", "repo": "openai/codex-plugin-cc" }
    },
    "ai-brain": {
      "source": { "source": "github", "repo": "lotoras/ai-brain" }
    },
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/threebrain-after-task.js" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/chat-log.js" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/session-model-guard.js" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/ssh-guard.js" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/noop-agent-guard.js" }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "useAutoModeDuringPlan": false,
  "tui": "fullscreen"
}
