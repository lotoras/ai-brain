{
  "$comment": "findings.json contract for laravel-vue-audit. validate-findings.cjs interprets this schema and adds semantic checks (priority matrix, dimension minimums, sorting, uniqueness).",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "description": "An independently verified code-health defect with a concrete consequence.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LVA-[0-9]{3,}$",
            "description": "Stable per-repo finding ID assigned by the parent; never reused."
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^D(?:[2-9]|1[0-2]):[a-z0-9]+(?:-[a-z0-9]+)*:[A-Za-z0-9_][A-Za-z0-9._:/@+-]*$",
            "description": "<dimension>:<category>:<primary-symbol-or-path>; stable across states and runs; no line numbers."
          },
          "dimension": {
            "type": "string",
            "enum": [
              "D2",
              "D3",
              "D4",
              "D5",
              "D6",
              "D7",
              "D8",
              "D9",
              "D10",
              "D11",
              "D12"
            ]
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Kebab-case pattern name, e.g. n-plus-one, missing-controller-method."
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "e.g. security-adjacent, money, cms-core."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "required": [
                "file",
                "line",
                "scope",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "description": "Either a file+line citation or a lookup (the search that came back empty/positive) — or both.",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "lookup": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "required": [
                "description"
              ],
              "additionalProperties": false
            }
          },
          "verdict": {
            "type": "string",
            "const": "confirmed"
          },
          "root_cause": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true,
            "description": "What concretely goes wrong (queries at scale, 500, wrong money, cache break, drift)."
          },
          "counter_evidence_checked": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "visibleContent": true
            },
            "description": "Controls looked for and not found (eager loads, later index migration, trait method, ...)."
          },
          "scale": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true,
            "description": "Required for D2/D3: table/page, rough sizes, call frequency."
          },
          "extraction_target": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true,
            "description": "Required for D4: scope/Action/FormRequest/composable/component to extract into."
          },
          "divergence": {
            "type": "object",
            "properties": {
              "verdict": {
                "type": "string",
                "enum": [
                  "identical",
                  "minor",
                  "diverged"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": [
              "verdict",
              "note"
            ],
            "additionalProperties": false
          },
          "impact": {
            "type": "object",
            "properties": {
              "score": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": [
              "score",
              "reason"
            ],
            "additionalProperties": false
          },
          "likelihood": {
            "type": "object",
            "properties": {
              "score": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": [
              "score",
              "reason"
            ],
            "additionalProperties": false
          },
          "priority": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "effort": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "confidence": {
            "type": "object",
            "properties": {
              "score": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": [
              "score",
              "reason"
            ],
            "additionalProperties": false
          },
          "remediation": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "regression_check": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true,
                "description": "Test or query-count assertion that would catch a regression."
              },
              "code_changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fixed_code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "file_name",
                    "fixed_code"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "strategy",
              "regression_check"
            ],
            "additionalProperties": false
          },
          "local_check": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "observed_result": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": [
              "command",
              "observed_result"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "verdict",
          "fingerprint",
          "dimension",
          "category",
          "tags",
          "title",
          "description",
          "locations",
          "evidence",
          "root_cause",
          "consequence",
          "counter_evidence_checked",
          "impact",
          "likelihood",
          "priority",
          "effort",
          "confidence",
          "remediation"
        ],
        "additionalProperties": false
      },
